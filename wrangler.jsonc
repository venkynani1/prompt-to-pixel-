{
  // Prompt to Pixel — Cloudflare Workers (Free plan). Everything here is free-tier only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompt-to-pixel",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Always build the React app before deploying (Workers Builds may skip the dashboard build command)
  "build": { "command": "npm run build" },
  "preview_urls": false,

  // React build served as static assets (free, unlimited requests). Only /api/* runs the Worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "ai": { "binding": "AI" },

  // Uncomment ONLY after confirming the Images binding is free on your account (see docs/FREE_TIER_REPORT.md).
  // It enables Round 1 side-by-side composites for single-image models.
  // "images": { "binding": "IMAGES" },

  "queues": {
    "producers": [{ "binding": "EVAL_QUEUE", "queue": "p2p-evals" }],
    "consumers": [{
      "queue": "p2p-evals",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 20,
      "max_concurrency": 4,
      "dead_letter_queue": "p2p-evals-dlq"
    }]
  },

  // Reconciliation safety net: closes expired rounds, recovers lost/stuck jobs, resumes paused jobs.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "PIN_PBKDF2_ITERATIONS": "20000",
    "STORAGE_MODE": "auto"
  },

  "observability": { "enabled": true, "head_sampling_rate": 0.2 }

  // Secrets (set by `npm run setup`, never committed, never sent to browsers):
  //   DATABASE_URL, ADMIN_TOKEN, S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
  //   OLLAMA_URL, OLLAMA_TOKEN (optional emergency fallback)
}
