# Used only by `npm run setup` / benchmark / loadtest on YOUR machine. Never commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEON_API_KEY=
# or instead of NEON_API_KEY:
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
EVENT_CODE=PIXEL1
EVENT_NAME=Prompt to Pixel
# Neon Object Storage (optional — otherwise compressed images go to Postgres BYTEA)
S3_ENDPOINT=
S3_BUCKET=p2p-images
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Emergency fallback judge (optional)
OLLAMA_URL=
OLLAMA_TOKEN=
